# Copy to .env and fill in. NEVER commit .env.
# In GitHub, set these as repository or environment secrets (Settings > Secrets and variables > Actions).

# ServiceNow personal developer instance (M2)
SERVICENOW_INSTANCE=https://devXXXXX.service-now.com
SERVICENOW_USER=
SERVICENOW_PASSWORD=

# Snowflake (M3) - key-pair auth for the CI service user
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=DQ_DEMO
SNOWFLAKE_PRIVATE_KEY_PATH=
